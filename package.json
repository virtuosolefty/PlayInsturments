{
  "name": "piano-practice-coach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Piano and guitar practice studio with Web MIDI, interactive tablature, Three.js stages and real-time music feedback.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-public-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "songs": "node scripts/build-songs.mjs",
    "shoot": "node scripts/shoot.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "test:e2e": "playwright test",
    "test:studio": "playwright test --config playwright.studio.config.js e2e/tests/00-smoke.spec.js e2e/tests/01-core-flows.spec.js e2e/tests/06-studio-guitar.spec.js e2e/tests/07-desktop-studio.spec.js e2e/tests/08-instrument-interactions.spec.js",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tonejs/midi": "^2.0.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "tone": "^15.0.4",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
